# Both addons carry the same icon, because they are one thing to the player and the list
# shows them next to each other. The file lives here; Family.toc says why it is not copied.
#
# The presentation layer. It reads through Family's own API and never touches FamilyDB
# directly - that separation is what lets the storage format change without the screens
# knowing (HANDOFF §1).

Window.lua
MemberPicker.lua
ChoicePicker.lua
Tooltip.lua
Summary.lua
Talents.lua
Contents.lua
Professions.lua
Character.lua
Quests.lua
Wide.lua
Guild.lua
Broker.lua
Options.lua
About.lua
Slash.lua

# The key bindings. XML because the client reads bindings out of a file of this shape before
# any addon Lua runs, and last because it needs everything above it to exist by the time a key
# is pressed.
Bindings.xml
