# Libraries fetched by tools/FetchLibs.sh so that a developer's install matches a released
# one. .pkgmeta fetches its own copies at package time, so these are for testing only and are
# somebody else's code besides - neither is a reason for them to be in our history.
addons/Family/Libs/

# Caches written by the data generators
tools/.itemsources-cache/
tools/.craftlevels-cache/

# Bytecode left behind when one generator imports another
tools/__pycache__/

# Generated by tools/GenerateCraftLevels.py. Generated data is never committed, only
# regenerated - docs/HANDOFF.md §3 - so the file is produced into the addon and ignored here.
addons/Family/Data/

# Per-machine Claude Code settings: the allow-list a session accumulates, and nothing that
# anybody else needs. .claude/settings.json beside it is tracked on purpose - the deny rules
# and the clean-room hook are part of how the rule is kept, so they travel with a clone.
.claude/settings.local.json
