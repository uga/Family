# How Family is packaged for CurseForge.
#
# Read by BigWigsMods/packager, which is the community's standard packager and the one
# CurseForge's own documentation points at. It builds the zip, sets the version from the git
# tag, and uploads.
#
# Two addons, one zip. Family is the data layer and Family_UI is everything the player sees,
# and neither is useful without the other - so they travel together and a player installs one
# thing. The alternative, two projects with a dependency between them, doubles the release
# work and gives somebody a way to end up with half of it.
package-as: Family

# Family's own folders sit under addons/ in this repository, and a WoW installation wants
# them at the top of the zip. Nothing else in the repository ships: the tools are generators
# that run on a developer's machine, and docs/ is for people reading the source.
move-folders:
    Family/addons/Family: Family
    Family/addons/Family_UI: Family_UI

ignore:
    - tools
    - tests
    - docs
    - .github
    - .gitignore
    - README.md
    - CHANGELOG.md
    - RELEASE-NOTES.md

# Two libraries, fetched at package time rather than committed. That keeps them at their own
# upstream version and keeps their licences theirs (HANDOFF §3), and it means this repository
# holds only what we wrote.
#
# They are optional everywhere in Family except Wide Family, which cannot exist without them:
# the addon channel carries a string and nothing else. Family works without them and says
# which it found; a player who installs from here gets them and never has to know.
#
# **The destination is relative to the package directory, which is the addon folder** - so it
# is `Libs/LibStub` and not `Family/Libs/LibStub`. Written with the package name in front,
# the packager put every library one level too deep, at `Family/Family/Libs`, where the .toc
# above never looked - and every release from v1.0.0 to v1.4.0 shipped with Wide Family and
# Guild share unable to send a byte. `move-folders` above is relative to the directory the
# package sits *in*, which is why the two look inconsistent and are not. tests/Harness.lua
# checks that every library the .toc loads is an external that lands where it looks.
externals:
    Libs/LibStub: https://repos.wowace.com/wow/libstub/trunk
    Libs/LibSerialize: https://github.com/rossnichols/LibSerialize
    Libs/LibDeflate: https://github.com/SafeteeWoW/LibDeflate

# The changelog CurseForge shows.
#
# **The packager sends this file whole.** Pointed at CHANGELOG.md it published every version
# since 1.0.0 on every release - 58 kB of history under an empty Unreleased heading - while
# this comment and the changelog's own header both said it published the release's section.
# Neither was true and nothing checked, because checking means opening a published release,
# which is the same thing five releases of missing libraries were waiting for (LESSONS L-038).
#
# tools/release.sh writes RELEASE-NOTES.md as part of the release commit: this version's
# section and nothing else. It is ignored above so that it does not travel inside the addon.
manual-changelog:
    filename: RELEASE-NOTES.md
    markup-type: markdown
