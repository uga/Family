name: the achievements walk runs every category in one frame, which is the Molten Core fault
file: addons/Family/Scanners/Character.lua
--- old
local function stepOn()
	local more, midway = Character:StepAchievements()
	if more then
		Family:After(midway and 0 or Character.CATEGORY_STEP, "character.achievements", stepOn)
	end
end
--- new
local function stepOn()
	while Character:StepAchievements() do end
end
