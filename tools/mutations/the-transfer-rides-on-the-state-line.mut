name: what is still being sent is appended to the state line again, where it is cut off
file: addons/Family_UI/Wide.lua
--- old
                local transfer = nextRow()
                transfer.text:SetPoint("RIGHT", -RIGHT_INSET, 0)
                transfer.text:SetText(transferWords)
                transferLines[entry.id] = transfer.text
--- new
                state.text:SetText((state.text:GetText() or "") .. "   " .. transferWords)
