name: an item tooltip draws the lane count in the column money is drawn in
file: addons/Family_UI/Tooltip.lua
--- old
				or L["%d items priced at auction prices"], held.atMarket),
				"", 0.6, 0.6, 0.6, 0.8, 0.8, 0.8 }
--- new
				or L["%d items priced at auction prices"], 0),
				tostring(held.atMarket), 0.6, 0.6, 0.6, 0.8, 0.8, 0.8 }
