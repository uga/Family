name: a material box is only as wide as its picture, leaving the gaps to the row
file: addons/Family_UI/Professions.lua
--- old
			hit:SetPoint("LEFT", icon, "LEFT", -MATERIAL_GAP / 2, 0)
			hit:SetPoint("RIGHT", icon, "RIGHT", MATERIAL_GAP / 2, 0)
--- new
			hit:SetPoint("LEFT", icon, "LEFT", 0, 0)
			hit:SetPoint("RIGHT", icon, "RIGHT", 0, 0)
