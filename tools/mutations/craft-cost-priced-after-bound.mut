--- new
		if self:BoundReagent(part.item) then
			row.bound = true
			row.total = 0
			out.bound = out.bound + 1
		elseif each then
			row.each, row.from = each, from
			row.total = each * part.count
			out.total = out.total + row.total
		elseif false then
