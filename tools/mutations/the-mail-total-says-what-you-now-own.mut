name: the mail total goes on to say what the character now owns, which was asked to be taken out
file: addons/Family_UI/MailReport.lua
--- old
		Family:Print(L["|cff66bbffTotal collected:|r %s"], UI:Coins(visitMoney))
--- new
		Family:Print(L["|cff66bbffTotal collected:|r %s"], UI:Coins(visitMoney))
		Family:Print("Now you own: %s", UI:Coins(tonumber((Family:TryCall(GetMoney))) or 0))
