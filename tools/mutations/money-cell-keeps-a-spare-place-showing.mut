name: a figure with fewer places leaves the spare one showing
file: addons/Family_UI/Window.lua
--- old
	for index = #pieces, #cell.__moneyPlaces do
		if cell.__moneyPlaces[index] then cell.__moneyPlaces[index]:Hide() end
	end
--- new
	for index = #pieces, #cell.__moneyPlaces do
		if cell.__moneyPlaces[index] then cell.__moneyPlaces[index]:Show() end
	end
