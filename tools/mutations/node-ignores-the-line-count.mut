name: a node is anything with two lines or more, and the cheapest test stops discarding
file: addons/Family_UI/Tooltip.lua
--- old
	if (tonumber((Family:TryCall(tooltip.NumLines, tooltip))) or 0) ~= 2 then return nil end
--- new
	if (tonumber((Family:TryCall(tooltip.NumLines, tooltip))) or 0) < 2 then return nil end
