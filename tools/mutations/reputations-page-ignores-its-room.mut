name: the whole-family reputations page folds at its old depth whatever room it has
file: addons/Family_UI/Character.lua
--- old
			local sizes = {}
			for _, row in ipairs(order) do
				if row.keep then sizes[#sizes + 1] = #row.people end
			end
			local cap = UI:FoldDepth(sizes, #topOrder, UI:RowsThatFit(scroll, height),
				UI.FACTION_PEOPLE)
--- new
			local cap = UI.FACTION_PEOPLE
