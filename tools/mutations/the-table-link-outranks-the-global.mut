name: the link on C_CurrencyInfo is believed over the global one
file: addons/Family/Scanners/Currencies.lua
--- old
	local id = idFromLink(Family:TryCall(_G.GetCurrencyListLink, index))
	if id then return id end

	local modern = _G.C_CurrencyInfo
	if type(modern) == "table" then
		id = idFromLink(Family:TryCall(modern.GetCurrencyListLink, index))
		if id then return id end
	end
--- new
	local modern = _G.C_CurrencyInfo
	local id = type(modern) == "table"
		and idFromLink(Family:TryCall(modern.GetCurrencyListLink, index)) or nil
	if id then return id end

	id = idFromLink(Family:TryCall(_G.GetCurrencyListLink, index))
	if id then return id end
