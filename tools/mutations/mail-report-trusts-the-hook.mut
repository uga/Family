name: the mailbox report announces what was asked for rather than what left
file: addons/Family_UI/MailReport.lua
--- old
		local gone = {}
		for itemID, was in pairs(held) do
			local still = (now[itemID] or {}).count or 0
			if was.count > still then gone[itemID] = was.count - still end
		end
--- new
		local gone = {}
		for itemID, was in pairs(held) do
			gone[itemID] = was.count
		end
