name: CTRL on a recipe row swaps to the recipe again instead of meaning what it means elsewhere
file: addons/Family_UI/Professions.lua
--- old
			if made then return "item", made, self.fallback end
--- new
			if made and not (IsControlKeyDown and IsControlKeyDown() and self.spellID) then
				return "item", made, self.fallback
			end
