name: the position is believed over the link on C_CurrencyInfo
file: addons/Family/Scanners/Currencies.lua
--- old
	local modern = _G.C_CurrencyInfo
	if type(modern) == "table" then
		id = idFromLink(Family:TryCall(modern.GetCurrencyListLink, index))
		if id then return id end
	end

	return idFromRow(row, width)
--- new
	local fromRow = idFromRow(row, width)
	if fromRow then return fromRow end

	local modern = _G.C_CurrencyInfo
	if type(modern) == "table" then
		id = idFromLink(Family:TryCall(modern.GetCurrencyListLink, index))
		if id then return id end
	end

	return nil
